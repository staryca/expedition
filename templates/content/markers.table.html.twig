{% extends 'base.content.html.twig' %}

{% block title %}
    {{ title }}
{% endblock %}

{% block stylesheets %}
    <style>
        #map { height: {{ geoMapData.height }}px; }
    </style>
{% endblock %}

{% block styles_finish %}
    {{ include('part/finish.for.geomapdata.html.twig') }}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="h2">{{ title }}</h1>
        <div class="row">
            <div class="p-2">
                <a href="{{ path('content_lists') }}">{{ all }}</a><br>
                Знойдзена {{ markers|length }} з {{ filters.getAmountItems() }} запісаў,
                <a data-bs-toggle="collapse" href="#collapseFilter" role="button" aria-expanded="false" aria-controls="collapseFilter">фільтр</a>
                <div class="collapse" id="collapseFilter">
                    <div class="card card-body">
                        <form method="post" action="#">

                        {% set filterCategories = filters.getCategories() %}
                        {% if filterCategories is not empty %}
                            <p class="h6">Тыпы:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedCategories() %}
                                {% for category, count in filterCategories %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_ca_{{ category }}" name="f[categories][{{ category }}]"
                                               {% if category in selected %}checked{% endif %}>
                                        <label for="f_ca_{{ category }}" class="form-check-label">
                                            {{ categories[category] }} ({{ count }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set filterRituals = filters.getRituals() %}
                        {% if filterRituals is not empty %}
                            <p class="h6">Катэгорыі:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedRituals() %}
                                {% for amountDto in filterRituals %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_ri_{{ amountDto.getId() }}" name="f[rituals][{{ amountDto.getId() }}]"
                                               {% if amountDto.getId() in selected %}checked{% endif %}>
                                        <label for="f_ri_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set filterDances = filters.getDances() %}
                        {% if filterDances is not empty %}
                            <p class="h6">Танцы:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedDances() %}
                                {% for amountDto in filterDances %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_da_{{ amountDto.getId() }}" name="f[dances][{{ amountDto.getId() }}]"
                                               {% if amountDto.getId() in selected %}checked{% endif %}>
                                        <label for="f_da_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set filterGeo = filters.getGeoAmounts() %}

                        {% set regions = filterGeo.getRegionAmounts() %}
                        {% if regions is not empty %}
                            <p class="h6">Вобласці:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedRegions() %}
                                {% for amountDto in regions %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_re_{{ amountDto.getId() }}" name="f[regions][{{ amountDto.getId() }}]"
                                               {% if amountDto.getName() in selected %}checked{% endif %}>
                                        <label for="f_re_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set districts = filterGeo.getDistricts() %}
                        {% if districts is not empty %}
                            <p class="h6">Раёны:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedDistricts() %}
                                {% for amountDto in districts %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_di_{{ amountDto.getId() }}" name="f[districts][{{ amountDto.getId() }}]"
                                               {% if amountDto.getName() in selected %}checked{% endif %}>
                                        <label for="f_di_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set places = filterGeo.getPlaces() %}
                        {% if places is not empty %}
                            <p class="h6">Населеныя пункты:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedPlaces() %}
                                {% for amountDto in places %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_pl_{{ amountDto.getId() }}" name="f[places][{{ amountDto.getId() }}]"
                                               {% if amountDto.getId() in selected %}checked{% endif %}>
                                        <label for="f_pl_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set packs = filters.getPackAmounts() %}
                        {% if packs is not empty %}
                            <p class="h6">Колькасць танцораў:</p>
                            <div class="row">
                                {% set selected = filters.getSelectedPacks() %}
                                {% for amountDto in packs %}
                                    <div class="col-md-3">
                                        <input type="checkbox" class="form-check-input"
                                               id="f_pl_{{ amountDto.getId() }}" name="f[packs][{{ amountDto.getId() }}]"
                                               {% if amountDto.getId() in selected %}checked{% endif %}>
                                        <label for="f_pl_{{ amountDto.getId() }}" class="form-check-label">
                                            {{ amountDto.getName() }} ({{ amountDto.getAmount() }})
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <br>

                        {% set improvisations = filters.getImprovisations() %}
                        {% if improvisations is not empty %}
                            <b>Тыпы танцаў</b>:
                            {% for name, amount in improvisations %}
                                {{ name }} ({{ amount }}){% if not loop.last %},{% endif %}
                            {% endfor %}
                        {% endif %}
                        <br>

                        {% set tags = filters.getTags() %}
                        {% if tags is not empty %}
                            <b>Тэгі</b>:
                            {% for amountDto in tags %}
                                {{ amountDto.getName() }} ({{ amountDto.getAmount() }}){% if not loop.last %},{% endif %}
                            {% endfor %}
                        {% endif %}

                            <button type="submit" class="btn btn-primary">Фільтраваць</button>
                        </form>
                    </div>
                </div>
            </div>

            {% if geoMapData.center %}
                <div id="map"></div>
            {% endif %}

            <table class="table">
                <thead>
                <tr>
                    <th scope="col">Год і месца</th>
                    <th scope="col">Назва</th>
                    <th scope="col"><span class="d-none d-md-block">Заўвагі</span></th>
                    <th scope="col">Відэа</th>
                </tr>
                </thead>

                <tbody>
                {% for marker in markers %}
                    <tr>
                        <td>
                            {% set report = marker.getReport() %}
                            {% set year = report.getDateActionYear() %}
                            {% if year %}{{ year }},{% endif %}

                            {% if report.geoPoint %}
                                <b>{{ report.geoPoint.getMiddleBeName() }}</b>
                                {%- if report.geoPoint.district %},
                                    {{ report.geoPoint.district }}
                                {% endif %}
                                <a href="{{ path('content_place', {id: report.geoPoint.id}) }}"><i class="bi bi-arrow-right-circle"></i></a>
                            {% else %}
                                {% set reportPlace = report.getGeoPlace() %}
                                {% if reportPlace %}
                                    {{ reportPlace }}
                                {% else %}
                                    [невядомае месца]
                                {% endif %}
                            {% endif %}
                        </td>
                        <td>
                            {{ marker.getCategoryName() }}:
                            {{ marker.name }}
                            {% for tag in marker.tags %}
                                <span class="badge text-bg-secondary">{{ tag.name }}</span>
                            {% endfor %}
                            <a href="{{ path('content_marker', {id: marker.id}) }}"><i class="bi bi-arrow-right-circle"></i></a>
                        </td>
                        <td>
                            {% if marker.ritual %}
                                {% for ritual in marker.ritual.getRitualList() %}
                                    {{- ritual.name -}}
                                    {% if not loop.last %}<i class="bi bi-arrow-right"></i>{% endif %}
                                {%- endfor -%}.

                                <br />
                                {% if marker.notes is not empty %}-----<br />{% endif %}
                            {% endif %}

                            <div class="d-none d-md-block">{{ marker.notes }}</div>

                            {% if marker.decoding %}
                                <button title="Расшыфроўка" class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ marker.id }}" aria-expanded="false" aria-controls="collapse{{ marker.id }}">
                                    <i class="bi bi-arrow-down-square-fill"></i>
                                </button>
                                <div class="collapse" id="collapse{{ marker.id }}">
                                    <div class="card card-body">
                                        {{ marker.decoding|nl2br }}
                                    </div>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            {% set youtube = marker.getAdditionalYoutube() %}
                            {% if youtube is not empty %}
                                {% if marker.isPublished() %}
                                    <img src="https://i.ytimg.com/vi/{{ youtube }}/default.jpg" />
                                    <a target="_blank" href="{{ marker.getAdditionalYoutubeLink() }}">Глядзець</a>
                                {% else %}
                                    <p>Будзе апублікавана {{ marker.getPublishDateText() }}</p>
                                {% endif %}
                            {% endif %}

                        </td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>

        </div>
    </div>
{% endblock %}